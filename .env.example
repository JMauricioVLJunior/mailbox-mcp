# Copy to .env and fill in. See config.py for full documentation.

# --- required ---
MCP_PUBLIC_URL=https://mcp-mail.example.com
MCP_EMAIL_DOMAIN=example.com
MCP_IMAP_HOST=imap.example.com

# --- optional (defaults shown) ---
#MCP_IMAP_PORT=993
#MCP_SMTP_HOST=imap.example.com
# 465 = implicit SSL. If your host blocks outbound 465 (Hetzner and others do), use 587:
#MCP_SMTP_PORT=465
#MCP_SMTP_SECURITY=          # 'ssl' or 'starttls'; empty = inferred (465->ssl, 587->starttls)
#MCP_CALDAV_URL_TEMPLATE=https://cal.example.com/calendars/{email}/Personal/
#MCP_TIMEZONE=UTC
#MCP_SENT_FOLDER=
#MCP_TRASH_FOLDER=
#MCP_DRAFTS_FOLDER=
#MCP_SEMANTICS_FILE=./semantics.yml
#MCP_SERVER_NAME=Mailbox MCP
#MCP_BIND_HOST=127.0.0.1
#MCP_BIND_PORT=8787
#MCP_DATA_DIR=./data

# verify IMAP/SMTP TLS certificates; set false ONLY for self-signed servers (insecure)
#MCP_TLS_VERIFY=true
# trust CF-Connecting-IP / X-Forwarded-For for login rate-limiting. Default false
# (fail-closed): set true ONLY when a trusted proxy/tunnel in front sets the header.
#MCP_TRUST_PROXY_HEADERS=false
